# Copy to .env and fill in your own values. Never commit a real key.
# OpenAI-compatible LLM endpoint (optional — without a key the app uses
# a clearly-labelled offline demo fallback, and the tests still pass).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
# Directory of markdown docs loaded at startup (relative to project root).
DATA_DIR=data/sample_docs
# Directory where the FAISS index + chunk metadata are persisted, so
# ingested documents survive restarts (default data/index).
INDEX_DIR=data/index
# API key for /ask and /ingest (X-API-Key header). Leave empty ONLY for
# local demos: with no key set the API runs open and logs a warning.
API_KEY=
# Retrieval defaults.
TOP_K=3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
